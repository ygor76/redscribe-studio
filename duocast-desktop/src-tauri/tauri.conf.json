{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuoCast",
  "version": "1.2.0",
  "identifier": "app.duocast.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "DuoCast",
        "url": "https://duocastapp.netlify.app/?desktop=1",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "devtools": false,
        "backgroundColor": "#0d0e11"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DuoCast Apps",
    "copyright": "DuoCast",
    "category": "SocialNetworking",
    "shortDescription": "Chamadas, chat e compartilhamento de tela.",
    "longDescription": "DuoCast Desktop: chamadas de voz, chat, câmera opcional e compartilhamento de tela em um aplicativo nativo para Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "minimumWebview2Version": "110.0.1531.0",
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
